@page "/transactions/{id}"
@using System.Net.Http.Json
@using Financial.Shared
@inject HttpClient Http
@inject NavigationManager navigation

<h3>Edit Transaction</h3>

@if (error != null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (record == null && error == null)
{
    <div class="spinner-border text-danger" role="status">
        <span class="visually-hidden"></span>
    </div>
}
else if (record != null)
{
<div class="row">
    <div class="col-md-6">
        <form @onsubmit:preventDefault>
            <div class="form-group">
                <label for="dateIncurred" class="control-label">Date Incurred</label>
                <input id="dateIncurred" class="form-control" type="date" @bind="record.DateIncurred" />
            </div>
            <div class="form-group">
                <label for="amount" class="control-label">Amount</label>
                <input id="amount" class="form-control" type="number" step="0.01" min="0" @bind="record.Amount" />
            </div>
            <div class="form-group">
                <label for="direction" class="control-label">Direction</label>
                <select id="direction" class="form-control" @bind="record.Direction">
                    @foreach (var item in Enum.GetValues<DebitCreditType>())
                    {
                        <option value="@item">@item</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="method" class="control-label">Transaction Method</label>
                <select id="method" class="form-control" @bind="record.TransactionMethod">
                    @foreach (var item in Enum.GetValues<TransactionType>())
                    {
                        <option value="@item">@item</option>
                    }
                </select>
            </div>
            @if (record.TransactionMethod == TransactionType.Check)
            {
            <div class="form-group">
                <label for="checkNumber" class="control-label">Check Number</label>
                <input id="checkNumber" class="form-control" @bind="record.CheckNumber" />
            </div>
            }
            @if (record.TransactionMethod == TransactionType.DigitalPayment)
            {
            <div class="form-group">
                <label for="digitalPaymentInfo" class="control-label">Payment Details</label>
                <input id="digitalPaymentInfo" class="form-control" @bind="record.DigitalPaymentInfo" />
            </div>
            }
            @if (record.TransactionMethod != TransactionType.Transfer)
            {
            <div class="form-group">
                <label for="generalAccount" class="control-label">General Account</label>
                <select id="generalAccount" class="form-control" @bind="record.GeneralAccountId">
                    <option value="">--None--</option>
                    @foreach (var account in accounts.Where(a => !a.SoftAccount))
                    {
                        <option value="@account.Id">@account.AccountName</option>
                    }
                </select>
            </div>
            }
            <div class="form-group">
                <label for="toAccount" class="control-label">To Account</label>
                <select id="toAccount" class="form-control" @bind="record.ToAccountId">
                    <option value="">--None--</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.AccountName</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="fromAccount" class="control-label">From Account</label>
                <select id="fromAccount" class="form-control" @bind="record.FromAccountId">
                    <option value="">--None--</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Id">@account.AccountName</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="event" class="control-label">Event</label>
                <select id="event" class="form-control" @bind="record.EventId">
                    <option value="">--None--</option>
                    @foreach (var ev in events)
                    {
                        <option value="@ev.Id">@ev.EventName</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="description" class="control-label">Description</label>
                <input id="description" class="form-control" @bind="record.Description" />
            </div>
        </form>
        <button @onclick="SaveTransaction" class="btn btn-primary" disabled="@busy">Save</button>
        <button @onclick="Cancel" class="btn" disabled="@busy">Cancel</button>
        @if (confirmingDelete)
        {
            <button @onclick="DeleteTransaction" class="btn btn-danger" disabled="@busy">Confirm delete</button>
            <button @onclick="@(() => confirmingDelete = false)" class="btn" disabled="@busy">Keep it</button>
        }
        else
        {
            <button @onclick="@(() => confirmingDelete = true)" class="btn btn-outline-danger" disabled="@busy">Delete</button>
        }
    </div>
</div>
}

@code {
    [Parameter]
    public string id { get; set; }

    private Transaction record;
    private List<Account> accounts;
    private List<FinancialEvent> events;
    private string error;
    private bool confirmingDelete;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            accounts = (await Http.GetFromJsonAsync<List<Account>>("api/GetAllAccounts") ?? new())
                .OrderBy(a => a.AccountName).ToList();
            events = (await Http.GetFromJsonAsync<List<FinancialEvent>>("api/events") ?? new())
                .OrderBy(e => e.EventName).ToList();
            record = await Http.GetFromJsonAsync<Transaction>("api/transactions/" + id);
        }
        catch (Exception ex)
        {
            // Unreachable host, 400/404/500, or a body that isn't the expected shape.
            record = null;
            error = "Couldn't load transaction: " + ex.Message;
        }
    }

    private Task SaveTransaction() => Send(Http.PutAsJsonAsync("api/transactions/" + id, record), "save");

    private Task DeleteTransaction() => Send(Http.DeleteAsync("api/transactions/" + id), "delete");

    // The API reverses and re-applies account balances itself; a failure leaves the user on the form.
    private async Task Send(Task<HttpResponseMessage> request, string verb)
    {
        error = null;
        busy = true;
        try
        {
            var response = await request;
            if (response.IsSuccessStatusCode)
            {
                navigation.NavigateTo("/transactions");
                return;
            }
            error = $"Couldn't {verb} transaction: {(int)response.StatusCode} {await response.Content.ReadAsStringAsync()}";
        }
        catch (Exception ex)
        {
            error = $"Couldn't {verb} transaction: " + ex.Message;
        }
        finally
        {
            busy = false;
            confirmingDelete = false;
        }
    }

    void Cancel()
    {
        navigation.NavigateTo("/transactions");
    }
}
