@page "/events"
@using System.Net.Http.Json
@using Financial.Shared
@inject HttpClient Http

<h3>Events</h3>

@if (error != null)
{
    <div class="alert alert-danger" role="alert">Couldn't load events: @error</div>
}
else if (events == null)
{
     <div class="spinner-border text-danger" role="status">
        <span class="visually-hidden"></span>
    </div>
}
else
{
    @if (events.Count == 0)
    {
        <p>No events yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Name</th>
                    <th>Balance</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var event_record in events)
                {
                    <tr>
                        <td>@event_record.RecordId</td>
                        <td>@event_record.EventName</td>
                        <td>@event_record.Balance</td>
                        <td><a class="btn btn-info" href="/event/@event_record.Id">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <a class="btn btn-primary" href="/event">Add Event</a>
}

@code {
    private List<FinancialEvent> events;
    private string error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            events = await Http.GetFromJsonAsync<List<FinancialEvent>>("api/events") ?? new();
        }
        catch (Exception ex)
        {
            // Unreachable host, non-2xx status, or a body that isn't an event list.
            error = ex.Message;
        }
    }
}
