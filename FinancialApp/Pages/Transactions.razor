@page "/transactions"
@using System.Net.Http.Json
@using Financial.Shared
@inject HttpClient Http

<div class="container">
    <div class="row">
        <div class="col">
            <h3>Transactions</h3>
        </div>
        <div class="col">
            <a class="btn btn-primary" href="/newEntry">New Transaction</a>
        </div>
    </div>
</div>

@if (error != null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (accounts == null && error == null)
{
    <div class="spinner-border text-danger" role="status">
        <span class="visually-hidden"></span>
    </div>
}
else if (accounts != null)
{
    <form class="form-inline mb-3" @onsubmit:preventDefault>
        <label for="accountFilter" class="mr-2">Account</label>
        <select id="accountFilter" class="form-control mr-4" value="@accountId" @onchange="@(e => Filter("account", e.Value?.ToString()))">
            <option value="">--Any--</option>
            @foreach (var account in accounts)
            {
                <option value="@account.Id">@account.AccountName</option>
            }
        </select>
        <label for="eventFilter" class="mr-2">Event</label>
        <select id="eventFilter" class="form-control" value="@eventId" @onchange="@(e => Filter("event", e.Value?.ToString()))">
            <option value="">--Any--</option>
            @foreach (var ev in events)
            {
                <option value="@ev.Id">@ev.EventName</option>
            }
        </select>
    </form>

    @if (transactions == null)
    {
        <p>Pick an account or an event to see its transactions.</p>
    }
    else if (transactions.Count == 0)
    {
        <p>No transactions found.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Direction</th>
                    <th>Method</th>
                    <th>Account</th>
                    <th>Event</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in transactions)
                {
                    <tr>
                        <td>@t.DateIncurred.ToString("yyyy-MM-dd")</td>
                        <td>@t.Amount.ToString("0.00")</td>
                        <td>@t.Direction</td>
                        <td>@t.TransactionMethod</td>
                        <td>@AccountLabel(t)</td>
                        <td>@EventName(t.EventId)</td>
                        <td><a class="btn btn-info" href="/transactions/@t.Id">Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<Account> accounts;
    private List<FinancialEvent> events;
    private List<Transaction> transactions;
    private string accountId = "";
    private string eventId = "";
    private string error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            accounts = (await Http.GetFromJsonAsync<List<Account>>("api/GetAllAccounts") ?? new())
                .OrderBy(a => a.AccountName).ToList();
            events = (await Http.GetFromJsonAsync<List<FinancialEvent>>("api/events") ?? new())
                .OrderBy(e => e.EventName).ToList();
        }
        catch (Exception ex)
        {
            accounts = null;
            error = "Couldn't load accounts and events: " + ex.Message;
        }
    }

    // The API filters by one thing at a time, so picking an account clears the event and vice versa.
    private async Task Filter(string by, string id)
    {
        accountId = by == "account" ? id ?? "" : "";
        eventId = by == "event" ? id ?? "" : "";
        transactions = null;
        error = null;
        if (string.IsNullOrEmpty(id)) return;
        try
        {
            transactions = (await Http.GetFromJsonAsync<List<Transaction>>($"api/transactions/{by}/{id}") ?? new())
                .OrderByDescending(t => t.DateIncurred).ToList();
        }
        catch (Exception ex)
        {
            error = "Couldn't load transactions: " + ex.Message;
        }
    }

    private string AccountName(string id) =>
        string.IsNullOrEmpty(id) ? null : accounts.FirstOrDefault(a => a.Id == id)?.AccountName ?? id;

    private string AccountLabel(Transaction t)
    {
        var from = AccountName(t.FromAccountId);
        var to = AccountName(t.ToAccountId);
        return from != null && to != null ? $"{from} → {to}" : to ?? from ?? AccountName(t.GeneralAccountId);
    }

    private string EventName(string id) =>
        string.IsNullOrEmpty(id) ? "" : events.FirstOrDefault(e => e.Id == id)?.EventName ?? id;
}
